DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Used directly when running `node src/index.js` against a local Postgres.
DATABASE_URL=postgres://user:password@localhost:5432/keizaal_inventory

# Used by docker-compose.yml instead of DATABASE_URL above — the bot
# container builds its own DATABASE_URL pointing at the db container.
POSTGRES_PASSWORD=

# S3 bucket for deploy/backup-db.sh (see DEPLOYMENT.md "Backups").
# Not a secret, but keeping it here matches how the bucket name is
# actually consumed by the backup script and cron job.
BACKUP_S3_BUCKET=
